# Credenciais do Octagora: preferencialmente cadastradas pela aba
# "Configurações" do frontend (ficam salvas em Backend/credentials.json).
# As variáveis abaixo só servem de fallback caso nada tenha sido cadastrado
# pela UI ainda.
OCTAGORA_ES_USER=
OCTAGORA_ES_PASS=

OCTAGORA_SP_USER=
OCTAGORA_SP_PASS=

# Defina 0 para ver o Chrome durante a extração (debug)
OCTAGORA_HEADLESS=true

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
